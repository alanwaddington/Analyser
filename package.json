		"@types/leaflet": "^1.9.21",
		"@types/marked": "^5.0.2",
		"@types/node": "^25.9.0",
		"@vitest/ui": "^4.1.6",
		"jsdom": "^29.1.1",
		"marked": "^18.0.4",
		"rollup-plugin-visualizer": "^7.0.1",
